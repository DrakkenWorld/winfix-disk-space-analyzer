<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WinFix-DiskSpaceAnalyzer</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../WinFix.Core/WinFix.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../LICENSE" LogicalName="WinFix.AppLicense" />
    <EmbeddedResource Include="../../.build/runtime-notices.txt" LogicalName="WinFix.RuntimeNotices" Condition="Exists('../../.build/runtime-notices.txt')" />
  </ItemGroup>
</Project>
